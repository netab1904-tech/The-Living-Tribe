<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- מספר הדירוג -->
        <TextView
            android:id="@+id/tvRankNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ic_launcher_background"
            android:backgroundTint="#CCD5AE"
            android:fontFamily="sans-serif-bold"
            android:gravity="center"
            android:text="4"
            android:textColor="#3D4A3E"
            android:textSize="15sp" />

        <!-- שם המשתמש ורצף ימים -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLeaderboardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Maya R."
                android:textColor="#3D4A3E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvLeaderboardStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-light"
                android:text="🔥 5-day streak"
                android:textColor="#7F8C72"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- נקודות השבט -->
        <TextView
            android:id="@+id/tvLeaderboardPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="320 pts"
            android:textColor="#58634D"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>